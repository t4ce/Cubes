// Generated port of the_one_cube_chroma.html; see tools/export_chroma.py.
// Both complete spherical presets retain the reference's 120 steps / 3 AO taps.
// iDate.xyz = packed authored sRGB; .w = 0 Folded Core, 1 Box Cathedral.
// iSampleRate = 1..3 colors. Pixels form a 3x2 cubemap with a one-texel gutter.
const float3 CAMERA = st_vec3(0.08f,-0.12f,0.05f);
const float FAR = 44.0f;
float max3(float3 v, __global const ShaderToyUniforms *st) {
    (void)st; return st_max(v.x,st_max(v.y,v.z)); }

// Exact zero isosurface of the uploaded mesh, in local coordinates:
// 24 unique vertices = signed permutations of (1,0.8,0.8).
// Six face planes, twelve edge-bevel planes, eight corner planes.
// This is a conservative distance BOUND, not an exact Euclidean SDF outside.
float oneCubeUnit(float3 p, __global const ShaderToyUniforms *st) {
    (void)st;
    float3 a=st_abs(p);
    float faces=max3(a, st)-1.0f;
    float edges=max3(st_vec3(a.x+a.y,a.x+a.z,a.y+a.z), st)-1.8f;
    float corners=a.x+a.y+a.z-2.6f;
    return st_max(faces,st_max(edges*0.70710678f,corners*0.57735027f));
}
float oneCube(float3 p,float size, __global const ShaderToyUniforms *st) {
    (void)st; return oneCubeUnit(p/size, st)*size; }
float octagon(float2 q, __global const ShaderToyUniforms *st) {
    (void)st;
    // Projection of the same 20%-inset seed onto an axis-aligned face.
    return st_max(st_max(q.x,q.y)-1.0f,(q.x+q.y-1.8f)*0.70710678f);
}

// Original cathedral's four recursive scales and factor-three repetition.
// Each level is now bounded by the 24-vertex seed; apertures have flat bevels.
// Thus the uploaded silhouette recurs throughout, rather than only enclosing it.
float2 cathedral(float3 p, __global const ShaderToyUniforms *st) {
    (void)st;
    p/=7.2f;
    float d=-100.0f, scale=1.0f, detail=0.0f;
    for (int i=0;i<4;++i) {
        float3 a=st_mod(p*scale,2.0f)-1.0f;
        float seed=oneCubeUnit(a, st)/scale;
        float3 r=st_abs(1.0f-3.0f*st_abs(a));
        float cut=st_min(octagon(r.xy, st),st_min(octagon(r.yz, st),octagon(r.zx, st)))/(3.0f*scale);
        float level=st_max(seed,cut);
        if (level>d) { d=level; detail=float(i); }
        scale*=3.0f;
    }
    return st_vec2(d*7.2f,detail);
}

// Exact Euclidean projection onto the convex 24-vertex seed, then reflect.
// The seed is [-0.8,0.8]^3 plus an L1 ball of radius 0.2. Projecting therefore
// reduces to soft-thresholding the three positive "excess beyond 0.8" values.
// 2*projection(z)-z is the beveled equivalent of the original box fold. Unlike
// sequential plane reflections, it preserves escaping orbits far from the seed.
float3 seedFold(float3 z, __global const ShaderToyUniforms *st) {
    (void)st;
    float3 a=st_abs(z);
    float3 excess=st_max(a-0.8f,0.0f);
    float largest=max3(excess, st);
    float smallest=st_min(excess.x,st_min(excess.y,excess.z));
    float sum=excess.x+excess.y+excess.z;
    float threshold=st_max(0.0f,st_max(largest-0.2f,
                    st_max((sum-smallest-0.2f)*0.5f,(sum-0.2f)/3.0f)));
    float3 projected=sign(z)*(st_min(a,0.8f)+st_max(excess-threshold,0.0f));
    return projected*2.0f-z;
}

// Original Folded core base: scale 3, sphere-fold amplification 1..4,
// nine recurrences, symmetric world-space aspect ratio. Bevel-seeded adaptation,
// not a claim that the original mathematical Mandelbox remains unchanged.
float2 foldedCore(float3 p, __global const ShaderToyUniforms *st) {
    (void)st;
    float3 q=st_mod(p+st_vec3(0.0f,0.0f,3.525f)+9.4f,18.8f)-9.4f;
    float3 c=q/2.35f, z=c;
    float derivative=1.0f, orbit=10.0f;
    for (int i=0;i<9;++i) {
        z=seedFold(z, st);
        float k=st_clamp(1.0f/st_max(dot(z,z),0.00001f),1.0f,4.0f);
        z*=k; derivative*=k;
        z=3.0f*z+c; derivative=3.0f*derivative+1.0f;
        orbit=st_min(orbit,st_abs(oneCubeUnit(z, st)));
    }
    float d=length(z)/derivative*2.35f-0.0035f;
    // A small chamfered safety pocket keeps the fixed observer in empty space.
    d=st_max(d,-oneCube(p,0.62f, st));
    return st_vec2(d,st_clamp(orbit*3.0f,0.0f,3.0f));
}
float2 map(float3 p, __global const ShaderToyUniforms *st) {
    (void)st;
    float2 inner=int((st->date).w)==0 ? foldedCore(p, st) : cathedral(p, st);
    float shell=-oneCube(p,17.5f, st);
    if (shell<inner.x) return st_vec2(shell,4.0f);
    return inner;
}
float3 cubeRay(float2 uv, int face, __global const ShaderToyUniforms *st) {
    (void)st;
    if (face==0) return normalize(st_vec3(1.0f,-uv.y,-uv.x));
    if (face==1) return normalize(st_vec3(-1.0f,-uv.y,uv.x));
    if (face==2) return normalize(st_vec3(uv.x,1.0f,uv.y));
    if (face==3) return normalize(st_vec3(uv.x,-1.0f,-uv.y));
    if (face==4) return normalize(st_vec3(uv.x,-uv.y,1.0f));
    return normalize(st_vec3(-uv.x,-uv.y,-1.0f));
}
float3 normalAt(float3 p,float eps, __global const ShaderToyUniforms *st) {
    (void)st;
    float2 e=st_vec2(1.0f,-1.0f)*eps;
    return normalize(e.xyy*map(p+e.xyy, st).x+e.yyx*map(p+e.yyx, st).x+
                     e.yxy*map(p+e.yxy, st).x+e.xxx*map(p+e.xxx, st).x);
}
float occlusion(float3 p,float3 n, __global const ShaderToyUniforms *st) {
    (void)st;
    float a=0.0f,weight=1.0f;
    for (int i=1;i<=3;++i) {
        float h=0.10f+float(i)*0.18f;
        a+=(h-map(p+n*h, st).x)*weight; weight*=0.52f;
    }
    return st_clamp(1.0f-1.75f*a,0.18f,1.0f);
}
float4 bakeMaterial(float3 rd, __global const ShaderToyUniforms *st) {
    (void)st;
    float travel=0.0f, hit=0.0f, epsilon=0.002f;
    float2 value=st_vec2(1.0f);
    for (int i=0;i<120;++i) {
        value=map(CAMERA+rd*travel, st);
        epsilon=st_max(0.0015f,travel*0.0005f);
        if (value.x<epsilon) { hit=1.0f; break; }
        travel+=st_max(value.x*0.68f,0.0009f);
        if (travel>FAR) break;
    }
    if (hit<0.5f) { return st_vec4(0.0f); }
    float3 p=CAMERA+rd*travel;
    float3 n=normalAt(p,st_max(0.0012f,epsilon*1.1f), st);
    float ao=occlusion(p,n, st);
    float facing=st_max(dot(n,-rd),0.0f);
    float key=st_max(dot(n,normalize(st_vec3(-0.45f,0.70f,-0.55f))),0.0f);
    float fill=st_max(dot(n,normalize(st_vec3(0.8f,-0.2f,0.4f))),0.0f);
    float tint=0.85f+0.15f*cos(value.y*1.8f);
    float light=(0.075f+0.30f*facing+0.65f*key+0.14f*fill)*ao*tint;
    float3 lightDirection=normalize(st_vec3(0.5f,1.8f,-0.2f)-p);
    light+=st_max(dot(n,lightDirection),0.0f)/(1.0f+0.025f*travel*travel)*0.30f;
    light+=st_pow(1.0f-facing,3.0f)*0.055f*ao;
    // Surface marks stay fixed in world space and survive every palette change.
    float3 nearest=st_abs(st_fract(p*0.42f+0.5f)-0.5f), absN=st_abs(n);
    float seam=absN.x>absN.y && absN.x>absN.z ? st_min(nearest.y,nearest.z)
               : absN.y>absN.z ? st_min(nearest.x,nearest.z) : st_min(nearest.x,nearest.y);
    light*=1.0f-(1.0f-st_smoothstep(0.008f,0.024f,seam))*0.13f;
    float band=1.0f-st_smoothstep(0.016f,0.033f,st_abs(st_fract(p.y*0.23f+0.11f)-0.5f));
    light+=band*0.11f*ao;
    // Geometry-aware material fields: broad faces, bevels, recursive recesses.
    // Their weights are baked, never tied to the screen or camera rotation.
    float bevel=1.0f-st_smoothstep(0.86f,0.995f,max3(absN, st));
    float story=0.5f+0.5f*sin(value.y*2.1f+p.y*0.45f+p.z*0.21f);
    float third=st_smoothstep(0.36f,0.88f,story)*0.82f;
    float second=(1.0f-third)*st_mix(0.04f,0.91f,bevel);
    return st_vec4(sqrt(st_clamp(light/1.6f,0.0f,1.0f)),second,third,exp(-travel*0.039f));
}


float linearChannel(float s, __global const ShaderToyUniforms *st) {
    (void)st;
    return s<=0.04045f ? s/12.92f : st_pow((s+0.055f)/1.055f,2.4f);
}
float3 linearColor(float rgb, __global const ShaderToyUniforms *st) {
    (void)st;
    float3 s=st_vec3(floor(rgb/65536.0f),st_mod(floor(rgb/256.0f),256.0f),st_mod(rgb,256.0f))/255.0f;
    return st_vec3(linearChannel(s.x, st),linearChannel(s.y, st),linearChannel(s.z, st));
}
void mainImage( float4 & fragColor,  float2 fragCoord, __global const ShaderToyUniforms *st) {
    (void)st;
    float stride=(st->resolution_time.xyz).x/3.0f;
    float faceSize=stride-2.0f;
    float2 tile=floor(fragCoord/stride);
    int face=int(tile.x+tile.y*3.0f);
    float2 uv=(st_mod(fragCoord,stride)-1.0f)/faceSize*2.0f-1.0f;
    float4 material=bakeMaterial(cubeRay(uv,face, st), st);
    float light=material.r*material.r*1.6f;
    float wb=material.g,wc=material.b,wa=st_max(0.0f,1.0f-wb-wc);
    float3 a=linearColor((st->date).x, st);
    float3 b=(st->timing.z)>1 ? linearColor((st->date).y, st) : a;
    float3 c=(st->timing.z)>2 ? linearColor((st->date).z, st) : ((st->timing.z)>1 ? st_mix(a,b,0.70f) : a);
    // Authored sRGB colors are converted once, as part of the bake.
    // A modest neutral component retains material readability and bright facets.
    float3 pigment=wa*a+wb*b+wc*c;
    float3 color=(pigment*0.67f+0.028f)*light;
    color+=st_vec3(st_pow(st_max(light-0.72f,0.0f),2.0f)*0.16f);
    float3 fog=0.0025f+st_mix(a,c,0.35f)*0.012f;
    color=st_mix(fog,color,material.a);
    color=1.0f-exp(-color*1.65f);
    color=st_pow(st_max(color,0.0f),st_vec3(1.0f/2.2f));
    fragColor=st_vec4(color,1.0f);
}

